# Example base environment variables (do NOT commit secrets)
# Copy to `.env` and edit for local use.
# Optionally set DJANGO_ENV=dev or DJANGO_ENV=pro to load `.env.<env>`
DJANGO_ENV=dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Service JWT
# SERVICE_JWT_SECRET=your-service-jwt-secret
# SERVICE_JWT_ISSUER=nextjs-service
# SERVICE_JWT_AUDIENCE=django-warranty-api

# DATABASE_URL optional: shown here as example for local docker dev
# DATABASE_URL=postgresql://postgres:postgres@db:5432/warranty_dev
